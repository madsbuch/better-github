{
  "$schema": "https://raw.githubusercontent.com/madsbuch/better-github/main/schema/spec.schema.json",
  "title": "Color",
  "summary": "Every color the app draws with, for light and for dark.",
  "status": "accepted",
  "order": 1,
  "description": "The palette follows GitHub's, so what is green, red or purple on github.com is the same here.",
  "stories": [
    {
      "id": "US-DS-1",
      "as": "someone reviewing at night",
      "want": "the whole app in dark colors",
      "soThat": "the screen doesn't light up the room",
      "requirements": [
        "#DS-C1",
        "#DS-C2"
      ]
    }
  ],
  "requirements": [
    {
      "id": "DS-C1",
      "text": "The app has a light and a dark look. Every color it draws with is a named value here, with the color for each."
    },
    {
      "id": "DS-C2",
      "text": "Which look is used follows the theme setting: the device's, or the one picked."
    },
    {
      "id": "DS-C3",
      "text": "A color means one thing everywhere: `color.success` open, passed or added; `color.danger` failed, destructive or removed; `color.attention` pending or a warning; `color.done` merged."
    },
    {
      "id": "DS-C4",
      "text": "A screen has at most one button in `color.btn-primary-bg`."
    },
    {
      "id": "DS-C5",
      "text": "The window behind the app, seen while it starts, is `color.bg` in both looks.",
      "level": "should"
    }
  ],
